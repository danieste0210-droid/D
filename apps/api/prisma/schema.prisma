// CloverApp Panamá - schema de datos
// Ver README raíz para contexto del negocio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooler) usada solo para `prisma migrate` -- el pooler de Neon
  // (pgbouncer, modo transacción) no soporta los locks que requieren las migraciones.
  directUrl = env("DIRECT_URL")
}

enum Role {
  super
  admin
  supervisor
  vendedor
}

enum SaleStatus {
  active
  cancelled
  paid
}

// recto: apuesta tradicional (2/3/4 cifras, últimas-cifras + bonos primeras/últimas-3/últimas-2
// cifras en 4). combinado: se juegan 3 o 4 cifras y el sistema cubre todas sus permutaciones
// contra el 1er premio. palet: se juegan 2 cifras; gana premio mayor si coincide con 1er Y 2do
// premio, O con 1er Y 3er premio, a la vez; premio menor si coincide con 2do Y 3er premio.
// chance3: "chance de tres cifras" -- coincidencia EXACTA (no permutación) contra un número
// derivado del resultado, ver processAwards.
enum BetType {
  recto
  combinado
  palet
  chance3
}

// Categoría de coincidencia para un multiplicador "recto": contra las últimas N cifras del
// resultado (la regla general). "primeras", "ultimas3" y "ultimas2" son bonos exclusivos de los
// billetes de 4 cifras completas (primeras 3 / últimas 3 / últimas 2 cifras), ver PayoutMultiplier.
enum MatchType {
  ultimas
  primeras
  ultimas3
  ultimas2
}

// 2 niveles (se paga solo el primero que coincida, en este orden):
// mayor: coincide con 1er Y 2do premio a la vez, O con 1er Y 3er premio a la vez (mismo pago).
// menor: coincide con 2do Y 3er premio a la vez.
enum PaletTier {
  mayor
  menor
}

enum AwardStatus {
  pending
  approved
  paid
  reversed
}

enum PaymentMethod {
  efectivo
  yappy
}

model User {
  id           String  @id @default(uuid())
  name         String
  username     String  @unique
  passwordHash String  @map("password_hash")
  role         Role
  active       Boolean @default(true)
  supervisorId String? @map("supervisor_id")
  supervisor   User?   @relation("SupervisorToVendors", fields: [supervisorId], references: [id])
  vendors      User[]  @relation("SupervisorToVendors")

  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  // Cifrado en reposo con AES-256-GCM (ver common/crypto/secret-encryption.ts), nunca en texto
  // plano. Se guarda aun sin confirmar 2FA todavía (ver auth 2fa/setup vs 2fa/verify).
  twoFactorSecret  String? @map("two_factor_secret")

  // Un solo token por usuario (simplificación del esqueleto) -- multi-dispositivo real
  // necesitaría una tabla aparte ligada a UserSession en vez de a User.
  expoPushToken String? @map("expo_push_token")

  // % de comisión del vendedor sobre sus ventas ("% GANANCIA" en la app de referencia).
  commissionPercent Decimal? @map("commission_percent") @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sales            Sale[]                  @relation("SellerSales")
  cancelledSales   Sale[]                  @relation("CancelledBySales")
  processedResults Result[]                @relation("ProcessedByResults")
  paidAwards       Award[]                 @relation("PaidAwards")
  auditLogs        AuditLog[]
  sessions         UserSession[]
  scheduleChanges  LotteryScheduleChange[]
  blockedNumbers   BlockedNumber[]

  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id])
  deviceLabel  String?   @map("device_label")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  refreshToken String    @unique @map("refresh_token")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  @@map("user_sessions")
}

model Lottery {
  id                 String   @id @default(uuid())
  name               String
  active             Boolean  @default(true)
  blocked            Boolean  @default(false)
  maxAmountPerNumber Decimal? @map("max_amount_per_number") @db.Decimal(12, 2)
  // Cantidad de posiciones de resultado que publica esta lotería: 3 = estándar (1er/2do/3er
  // premio, la mayoría), 1 = un solo resultado (El Salvador). Determina qué modalidades se
  // ofrecen -- palé y "chance de tres cifras" necesitan al menos 2 posiciones.
  resultPositions Int @default(3) @map("result_positions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  closures             Closure[]
  sales                Sale[]
  results              Result[]
  scheduleChanges      LotteryScheduleChange[]
  payoutMultipliers    PayoutMultiplier[]
  blockedNumbers       BlockedNumber[]
  combinadoMultipliers CombinadoMultiplier[]
  paletMultipliers     PaletMultiplier[]
  chance3Multipliers   Chance3Multiplier[]

  @@map("lotteries")
}

// Tabla de pagos: cuánto se paga por cada combinación de cifras jugadas (2/3/4) y posición del
// resultado (1ra/2da/3ra) en esta lotería. Reemplaza el multiplicador plano anterior -- el juego
// real es tipo quiniela/pale, no un multiplicador único.
model PayoutMultiplier {
  id         String    @id @default(uuid())
  lotteryId  String    @map("lottery_id")
  lottery    Lottery   @relation(fields: [lotteryId], references: [id])
  digitCount Int       @map("digit_count") // 2, 3 o 4 -- cantidad de cifras que jugó el cliente
  position   Int // 1, 2 o 3 -- posición del resultado (1ra/2da/3ra)
  matchType  MatchType @default(ultimas) @map("match_type")
  multiplier Decimal   @db.Decimal(8, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lotteryId, digitCount, position, matchType])
  @@map("payout_multipliers")
}

// Multiplicador de Combinado: se juegan 3 o 4 cifras y ganan todas sus permutaciones contra
// el 1er premio únicamente (ver processAwards).
model CombinadoMultiplier {
  id         String  @id @default(uuid())
  lotteryId  String  @map("lottery_id")
  lottery    Lottery @relation(fields: [lotteryId], references: [id])
  digitCount Int     @map("digit_count") // 3 o 4
  multiplier Decimal @db.Decimal(8, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lotteryId, digitCount])
  @@map("combinado_multipliers")
}

// Multiplicador de Palet: apuesta de 2 cifras que paga si coincide con dos posiciones a la vez.
model PaletMultiplier {
  id         String    @id @default(uuid())
  lotteryId  String    @map("lottery_id")
  lottery    Lottery   @relation(fields: [lotteryId], references: [id])
  tier       PaletTier
  multiplier Decimal   @db.Decimal(8, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lotteryId, tier])
  @@map("palet_multipliers")
}

// Multiplicador de "chance de tres cifras": un solo valor por lotería (no depende de posición ni
// cantidad de cifras) -- coincidencia exacta contra el número derivado, ver processAwards.
model Chance3Multiplier {
  id         String  @id @default(uuid())
  lotteryId  String  @unique @map("lottery_id")
  lottery    Lottery @relation(fields: [lotteryId], references: [id])
  multiplier Decimal @db.Decimal(8, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chance3_multipliers")
}

// Números que un admin bloquea para que no se puedan jugar en una lotería (control de riesgo).
model BlockedNumber {
  id          String  @id @default(uuid())
  lotteryId   String  @map("lottery_id")
  lottery     Lottery @relation(fields: [lotteryId], references: [id])
  number      String
  createdById String  @map("created_by_id")
  createdBy   User    @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([lotteryId, number])
  @@map("blocked_numbers")
}

// Horario de cierre por lotería y día de la semana (excepción al horario general de
// ClosureDefault para ese día). Timezone siempre America/Panama.
model Closure {
  id        String  @id @default(uuid())
  lotteryId String  @map("lottery_id")
  lottery   Lottery @relation(fields: [lotteryId], references: [id])
  dayOfWeek Int     @map("day_of_week") // 0 = domingo ... 6 = sábado
  // Modo "Rango": si se define, la lotería solo vende entre openTime y closeTime. Modo "Día"
  // (openTime null): vende desde medianoche hasta closeTime.
  openTime  String? @map("open_time") // "HH:mm" en America/Panama
  closeTime String  @map("close_time") // "HH:mm" en America/Panama

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lotteryId, dayOfWeek])
  @@map("closures")
}

// Horario general por día de la semana, aplicado a cualquier lotería que no tenga su propio
// Closure para ese día (fallback/plantilla). Mismas reglas de openTime que Closure.
model ClosureDefault {
  id        String  @id @default(uuid())
  dayOfWeek Int     @unique @map("day_of_week") // 0 = domingo ... 6 = sábado
  openTime  String? @map("open_time")
  closeTime String  @map("close_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("closure_defaults")
}

// Historial de cambios de horario (quién y cuándo modificó un cierre).
model LotteryScheduleChange {
  id          String   @id @default(uuid())
  lotteryId   String   @map("lottery_id")
  lottery     Lottery  @relation(fields: [lotteryId], references: [id])
  changedById String   @map("changed_by_id")
  changedBy   User     @relation(fields: [changedById], references: [id])
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("lottery_schedule_changes")
}

model Sale {
  id            String     @id @default(uuid())
  // Todas las líneas generadas por un mismo "Procesar" (una o varias loterías x tipos de
  // apuesta) comparten un batchId -- es la "venta" que ve el vendedor/cliente como una sola
  // unidad (un recibo, un código, una cancelación), aunque por debajo siga habiendo una fila
  // por lotería x tipo de apuesta (necesario para el cálculo de premios por separado).
  batchId       String     @default(uuid()) @map("batch_id")
  sellerId      String     @map("seller_id")
  seller        User       @relation("SellerSales", fields: [sellerId], references: [id])
  lotteryId     String     @map("lottery_id")
  lottery       Lottery    @relation(fields: [lotteryId], references: [id])
  numberPlayed  String     @map("number_played")
  amount        Decimal    @db.Decimal(12, 2)
  betType       BetType    @default(recto) @map("bet_type")
  // Capturados en la pantalla "Números y Valores" -- opcionales, para poder ubicar la venta si
  // el cliente reclama un premio.
  customerName  String?    @map("customer_name")
  customerPhone String?    @map("customer_phone")
  // Código corto compartido por todas las líneas del mismo batchId (lo que ve el cliente en el
  // recibo, ej. "382520") -- ya no es único por fila individual, la identidad real es batchId.
  ticketCode    String     @map("ticket_code")
  status        SaleStatus @default(active)

  createdAt     DateTime  @default(now()) @map("created_at")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelledBy   User?     @relation("CancelledBySales", fields: [cancelledById], references: [id])
  cancelReason  String?   @map("cancel_reason")

  // Una venta puede ganar en varias posiciones a la vez (paga todas las que coincidan) -- ver
  // regla de coincidencia por últimas N cifras en lotteries.service.processAwards().
  awards Award[]

  // Resultado contra el que ya se evaluó esta venta (haya ganado o no) -- evita que una venta que
  // sigue "activa" (status solo cambia al cancelar) se vuelva a evaluar contra un resultado
  // POSTERIOR de la misma lotería, lo cual además de ser incorrecto (una venta es para un sorteo
  // puntual, no para todos los futuros) puede chocar con la restricción única (sale_id, position)
  // de Award. Se limpia en resultsService.reverse() si el resultado se revierte, para que la
  // venta vuelva a quedar elegible ante un resultado corregido.
  resolvedResultId String?  @map("resolved_result_id")
  resolvedResult   Result?  @relation("ResolvedSales", fields: [resolvedResultId], references: [id])

  @@index([sellerId, createdAt])
  @@index([lotteryId, createdAt])
  @@index([batchId])
  @@index([resolvedResultId])
  @@map("sales")
}

model Result {
  id             String    @id @default(uuid())
  lotteryId      String    @map("lottery_id")
  lottery        Lottery   @relation(fields: [lotteryId], references: [id])
  drawDate       DateTime  @map("draw_date")
  // Quiniela: hasta 3 números ganadores, cada uno de hasta 4 cifras. Un número jugado de N
  // cifras gana si coincide con las últimas N cifras de cualquiera de estos tres. segundo/tercer
  // premio son opcionales -- loterías de un solo resultado (ej. El Salvador, Lottery.resultPositions
  // = 1) los dejan en null; processAwards excluye automáticamente las modalidades que los
  // necesitan (palé, chance de tres cifras, recto contra 2da/3ra posición).
  firstNumber    String    @map("first_number")
  secondNumber   String?   @map("second_number")
  thirdNumber    String?   @map("third_number")
  processedById  String    @map("processed_by_id")
  processedBy    User      @relation("ProcessedByResults", fields: [processedById], references: [id])
  processedAt    DateTime  @default(now()) @map("processed_at")
  reversedAt     DateTime? @map("reversed_at")
  reversalReason String?   @map("reversal_reason")

  awards Award[]
  resolvedSales Sale[] @relation("ResolvedSales")

  @@unique([lotteryId, drawDate])
  @@map("results")
}

model Award {
  id            String         @id @default(uuid())
  saleId        String         @map("sale_id")
  sale          Sale           @relation(fields: [saleId], references: [id])
  resultId      String         @map("result_id")
  result        Result         @relation(fields: [resultId], references: [id])
  // Posición del resultado que coincidió (1, 2 o 3) -- una venta puede tener hasta 3 awards,
  // uno por cada posición ganadora.
  position      Int
  // Qué regla de coincidencia generó este award ("ultimas", "primeras", "ultimas3", "ultimas2",
  // "combinado", "palet-mayor", "palet-menor", "chance3") -- una misma venta puede ganar VARIAS
  // categorías a la vez en la MISMA posición (ej. un billete de 4 cifras exacto también califica
  // para los bonos de primeras/últimas cifras), así que "position" solo no identifica un award.
  category      String
  amount        Decimal        @db.Decimal(12, 2)
  status        AwardStatus    @default(pending)
  paymentMethod PaymentMethod? @map("payment_method")
  paidAt        DateTime?      @map("paid_at")
  paidById      String?        @map("paid_by_id")
  paidBy        User?          @relation("PaidAwards", fields: [paidById], references: [id])
  reversedAt    DateTime?      @map("reversed_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Evita doble-conteo dentro de UN mismo cálculo (misma venta, mismo resultado, misma posición,
  // misma categoría), pero SÍ permite que una venta gane de nuevo ante un resultado corregido
  // (resultId distinto) tras una reversión -- ver resolvedResultId en Sale.
  @@unique([saleId, resultId, position, category])
  @@map("awards")
}

// Log de auditoría inmutable para toda acción que mueva dinero o cambie configuración sensible.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}
