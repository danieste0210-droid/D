# PostgreSQL (Supabase, Neon o local via docker-compose)
# DATABASE_URL: conexión pooled (runtime de la app). DIRECT_URL: conexión directa, sin pooler
# (solo la usa `prisma migrate`). En Docker local ambas pueden apuntar al mismo valor.
DATABASE_URL="postgresql://cloverapp:cloverapp@localhost:5432/cloverapp?schema=public"
DIRECT_URL="postgresql://cloverapp:cloverapp@localhost:5432/cloverapp?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Clave AES-256 (hex de 64 caracteres = 32 bytes) para cifrar secretos en reposo (hoy: 2FA TOTP).
# Generar una nueva por entorno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-me-64-char-hex-generate-with-crypto-randomBytes-32-toString-hex"

# App
PORT=3000
NODE_ENV=development
TIMEZONE="America/Panama"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
